# Copy this file to .env and fill in your values

# ─── Your machine's local Wi-Fi IP ───────────────────────────────────────────
# Run: ipconfig (Windows) or ifconfig (Mac/Linux)
# Required so Expo Go on a physical device can reach the backend
EXPO_PUBLIC_API_HOST=192.168.x.x

# ─── AI Microservice URLs (auto-detected from host above if not set) ─────────
# EXPO_PUBLIC_CHATBOT_API=http://192.168.x.x:8000
# EXPO_PUBLIC_SENTIMENT_API=http://192.168.x.x:8001
# EXPO_PUBLIC_CONTEXT_API=http://192.168.x.x:8002
# EXPO_PUBLIC_PRODUCTS_API=http://192.168.x.x:8003
# EXPO_PUBLIC_TRENDS_API=http://192.168.x.x:8004
# EXPO_PUBLIC_FEEDBACK_API=http://192.168.x.x:8005
